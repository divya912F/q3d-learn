# Copy to .env and fill in what you need. Everything is optional.

# Database — SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://q3d:q3d@localhost:5432/q3d_learn
# DATABASE_URL=sqlite:///./q3d_learn.db

# Simulator: auto (Qiskit Aer if installed) | q3d | qiskit
QUANTUM_BACKEND=auto

# AI tutor: auto | openai | gemini | offline
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible server works, e.g. a local Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
HOST=127.0.0.1
PORT=8000
RELOAD=1
CORS_ORIGINS=*
